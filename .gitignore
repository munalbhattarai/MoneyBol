*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/androidTestResultsUserPreferences.xml

# Keystore files (never commit private signing keys)
*.jks
*.keystore

# OS specific files
.DS_Store
Thumbs.db

# Log files
*.log

# Profiling and memory dumps
captures/
*.hprof
